# --- Database (Local: Neon) ---
DATABASE_DRIVER=neon
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Database (Production: Cloud SQL) — uncomment and fill when deploying. ---
# DATABASE_URL is not needed in this mode; CLOUD_SQL_INSTANCE_CONNECTION_NAME
# takes over connection resolution.
# DATABASE_DRIVER=pg
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=project:region:instance
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxx
# /ingresar hosts both tabs (login + register, see docs/specs/auth-ui.md) —
# there is no separate /sign-up route, so both vars point at the same path.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/ingresar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/ingresar

# --- Payments (Stripe) ---
# Use a restricted API key (rk_), not a secret key (sk_): Dashboard > Developers >
# API keys > Create restricted key (Checkout Sessions, Invoices, Payment Intents: write).
# Develop against your own Stripe sandbox, not the account's shared test mode.
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxx
# Local: keep `npm run stripe:listen` running next to `npm run dev`. It forwards events using
# the account of STRIPE_SECRET_KEY (not the `stripe login` one) and warns if the whsec_ below
# does not match that account. Without it, paid orders stay "pending" and /mis-entradas is empty.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
PLATFORM_FEE_PERCENT=10
